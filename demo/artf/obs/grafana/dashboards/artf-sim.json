    {
      "id": 6,
      "type": "timeseries",
      "title": "RTBlint latency vs 150ms tmax",
      "description": "Server-side ValidateArtfMutations. Histogram quantiles interpolate between bucket edges. The dashed line is envelope tmax, not a SLO we are close to missing.",
      "gridPos": {
        "h": 8,
        "w": 9,
        "x": 0,
        "y": 14
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(rtblint_grpc_request_duration_seconds_bucket{method=\"ValidateArtfMutations\"}[30s]))) * 1000",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(rtblint_grpc_request_duration_seconds_bucket{method=\"ValidateArtfMutations\"}[30s]))) * 1000",
          "legendFormat": "p99"
        },
        {
          "refId": "C",
          "expr": "vector(150)",
          "legendFormat": "tmax 150ms"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "tmax 150ms"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#ef6b73",
                  "mode": "fixed"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "dash": [
                    8,
                    4
                  ],
                  "fill": "dash"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
