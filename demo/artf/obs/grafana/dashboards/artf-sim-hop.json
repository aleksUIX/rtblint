{
  "uid": "artf-sim-hop",
  "title": "ARTF sim · the hop",
  "description": "Episode 1 view. Auctions are the mixer. Hop p99 is the apply RPC, against 150ms tmax. Drop should sit at zero on the production mix. Synthetic mix, laptop slice.",
  "timezone": "browser",
  "refresh": "1s",
  "schemaVersion": 39,
  "tags": ["artf"],
  "time": { "from": "now-1m", "to": "now" },
  "liveNow": true,
  "editable": true,
  "graphTooltip": 1,
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Read this first",
      "gridPos": { "h": 2, "w": 24, "x": 0, "y": 0 },
      "options": {
        "mode": "markdown",
        "content": "**This hop, not a QPS trophy.** Auctions per second is completed hops on this laptop, not the dial. Forward rate should sit near 100% here: suppress and shade still forward. **Hop p99** is the apply RPC, far under the **150ms tmax**. Drop at zero means this mix planted no illegal writes. Synthetic mix, laptop slice. Independent simulation."
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Auctions / s",
      "gridPos": { "h": 4, "w": 5, "x": 0, "y": 2 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum(rate(artf_sim_auctions_total[10s]))" }],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "semi-dark-green", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto",
        "wideLayout": true
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Forward rate",
      "gridPos": { "h": 4, "w": 5, "x": 5, "y": 2 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{
        "refId": "A",
        "expr": "sum(rate(artf_sim_auctions_total{outcome=\"forward\"}[10s])) / clamp_min(sum(rate(artf_sim_auctions_total[10s])), 0.0001)"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "semi-dark-red", "value": null },
              { "color": "semi-dark-orange", "value": 0.9 },
              { "color": "semi-dark-green", "value": 0.99 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto",
        "wideLayout": true
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Drop rate",
      "description": "Zero on this mix. Missing drop series is treated as 0.",
      "gridPos": { "h": 4, "w": 4, "x": 10, "y": 2 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{
        "refId": "A",
        "expr": "(sum(rate(artf_sim_auctions_total{outcome=\"drop\"}[10s])) or vector(0)) / clamp_min(sum(rate(artf_sim_auctions_total[10s])), 0.0001)"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "semi-dark-green", "value": null },
              { "color": "semi-dark-orange", "value": 0.02 },
              { "color": "semi-dark-red", "value": 0.1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto",
        "wideLayout": true
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Hop p99",
      "description": "Apply RPC p99. Demo sleeps are not in this number. Must sit far under 150ms tmax.",
      "gridPos": { "h": 4, "w": 5, "x": 14, "y": 2 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{
        "refId": "A",
        "expr": "histogram_quantile(0.99, sum by (le) (rate(rtblint_grpc_request_duration_seconds_bucket{method=\"ValidateArtfMutations\"}[30s]))) * 1000"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 2,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "semi-dark-green", "value": null },
              { "color": "semi-dark-orange", "value": 20 },
              { "color": "semi-dark-red", "value": 150 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto",
        "wideLayout": true
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "tmax headroom",
      "description": "150ms minus hop p99. Budget left for the rest of the bid.",
      "gridPos": { "h": 4, "w": 5, "x": 19, "y": 2 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{
        "refId": "A",
        "expr": "150 - (histogram_quantile(0.99, sum by (le) (rate(rtblint_grpc_request_duration_seconds_bucket{method=\"ValidateArtfMutations\"}[30s]))) * 1000)"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 1,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "semi-dark-red", "value": null },
              { "color": "semi-dark-orange", "value": 50 },
              { "color": "semi-dark-green", "value": 130 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto",
        "wideLayout": true
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Mix by beat (stacked)",
      "description": "Production mix: clean, suppress, shade. No planted illegal writes.",
      "gridPos": { "h": 10, "w": 14, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{
        "refId": "A",
        "expr": "sum by (beat) (rate(artf_sim_auctions_total[10s]))",
        "legendFormat": "{{beat}}"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 40,
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "mode": "normal", "group": "A" }
          }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "clean" }, "properties": [{ "id": "color", "value": { "fixedColor": "#3dcc73", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "suppress" }, "properties": [{ "id": "color", "value": { "fixedColor": "#5794f2", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "shade" }, "properties": [{ "id": "color", "value": { "fixedColor": "#b877d9", "mode": "fixed" } }] }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Hop p99 vs 150ms tmax",
      "description": "Dashed line is envelope tmax. Mass should sit in the first milliseconds.",
      "gridPos": { "h": 10, "w": 10, "x": 14, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(rtblint_grpc_request_duration_seconds_bucket{method=\"ValidateArtfMutations\"}[30s]))) * 1000",
          "legendFormat": "p99"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(rtblint_grpc_request_duration_seconds_bucket{method=\"ValidateArtfMutations\"}[30s]))) * 1000",
          "legendFormat": "p50"
        },
        {
          "refId": "C",
          "expr": "vector(150)",
          "legendFormat": "tmax"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0,
          "max": 160,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "p99" },
            "properties": [{ "id": "color", "value": { "fixedColor": "#ff9830", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "tmax" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "#8e8e8e", "mode": "fixed" } },
              { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [8, 8] } },
              { "id": "custom.fillOpacity", "value": 0 }
            ]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    }
  ]
}
